{
  "name": "komodo-wallet-desktop",
  "version-string": "0.9.9",
  "dependencies": [
    "boost-multiprecision",
    "boost-thread",
    "boost-random",
    "boost-lockfree",
    "openssl",
    "nlohmann-json",
    "libsodium",
    "fmt",
    {
      "name": "spdlog",
      "features": [
        {
          "name": "wchar",
          "platform": "windows"
        }
      ]
    },
    "date",
    "asyncplusplus",
    "cpr",
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "ssl"
      ]
    },
    "entt",
    "refl-cpp",
    "strong-type",
    "tl-expected"
  ],
  "builtin-baseline": "dee92af2943e2216d7ba21ec4516a2c538c34c53"
}
